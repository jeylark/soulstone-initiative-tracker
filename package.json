{
	"name": "soulstone-initiative-tracker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"fake-indexeddb": "^6.2.7",
		"globals": "^17.14.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"minimatch": "^11.0.4"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/challenge": "./src/lib/challenge/index.ts",
		"#lib/components": "./src/lib/components/index.ts",
		"#lib/server": "./src/lib/server/index.ts",
		"#lib/*": null
	}
}
